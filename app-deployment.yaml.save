apiVersion: apps/v1
kind: Deployment
metadata:
  name: seat-reservation-app
  namespace: event-seat
spec:
  replicas: 2
  selector:
    matchLabels:
      app: seat-reservation-app
  template:
    metadata:
      labels:
        app: seat-reservation-app
    spec:
      containers:
        - name: app
          image: eventseatreservation-app:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8000
          env:
            - name: DATABASE_URL
              value: postgresql://seatapp:seatapp123@postgres:5432/seat_reservation
            - name: REDIS_URL
              value: redis://redis:6379/0

          readinessProbe:
            httpGet:
             path: /healthz
             port: 8000
           initialDelaySeconds: 5
           periodSeconds: 10

          livenessProbe:
             httpGet:
              path: /healthz
              port: 8000
  initialDelaySeconds: 15
  periodSeconds: 20
